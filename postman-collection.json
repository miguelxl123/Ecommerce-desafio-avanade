{
  "info": {
    "name": "Ecommerce Microservices API",
    "description": "Collection completa para testar o sistema de ecommerce com microserviços",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "vendas_url",
      "value": "http://localhost:5001",
      "type": "string"
    },
    {
      "key": "estoque_url",
      "value": "http://localhost:5002",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.token) {",
                  "        pm.collectionVariables.set('token', response.data.token);",
                  "        console.log('Token JWT salvo:', response.data.token.substring(0, 50) + '...');",
                  "    }",
                  "}",
                  "",
                  "pm.test('Login realizado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.token).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecommerce.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@ecommerce.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Validar Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "validate"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Produtos (Estoque)",
      "item": [
        {
          "name": "Listar Produtos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Produtos listados com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data).to.be.an('array');",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.data && response.data.length > 0) {",
                  "        pm.collectionVariables.set('product_id', response.data[0].id);",
                  "        console.log('ID do primeiro produto salvo:', response.data[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventario/products",
              "host": ["{{base_url}}"],
              "path": ["api", "inventario", "products"]
            }
          }
        },
        {
          "name": "Obter Produto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/inventario/products/11111111-1111-1111-1111-111111111111",
              "host": ["{{base_url}}"],
              "path": ["api", "inventario", "products", "11111111-1111-1111-1111-111111111111"]
            }
          }
        },
        {
          "name": "Verificar Disponibilidade",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"11111111-1111-1111-1111-111111111111\",\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/inventario/products/availability",
              "host": ["{{base_url}}"],
              "path": ["api", "inventario", "products", "availability"]
            }
          }
        },
        {
          "name": "Criar Produto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Produto Teste Postman\",\n  \"description\": \"Produto criado via Postman\",\n  \"price\": 299.99,\n  \"stockQuantity\": 100,\n  \"category\": \"Teste\",\n  \"sku\": \"POST-{{$randomInt}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/inventario/products",
              "host": ["{{base_url}}"],
              "path": ["api", "inventario", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Pedidos (Vendas)",
      "item": [
        {
          "name": "Criar Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data.id) {",
                  "        pm.collectionVariables.set('order_id', response.data.id);",
                  "        console.log('ID do pedido salvo:', response.data.id);",
                  "    }",
                  "}",
                  "",
                  "pm.test('Pedido criado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.success).to.be.true;",
                  "    pm.expect(response.data.id).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"11111111-1111-1111-1111-111111111111\",\n      \"quantity\": 2\n    },\n    {\n      \"productId\": \"22222222-2222-2222-2222-222222222222\",\n      \"quantity\": 1\n    }\n  ],\n  \"notes\": \"Pedido de teste via Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/vendas/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "vendas", "orders"]
            }
          }
        },
        {
          "name": "Listar Meus Pedidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vendas/orders",
              "host": ["{{base_url}}"],
              "path": ["api", "vendas", "orders"]
            }
          }
        },
        {
          "name": "Obter Pedido por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vendas/orders/{{order_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "vendas", "orders", "{{order_id}}"]
            }
          }
        },
        {
          "name": "Confirmar Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vendas/orders/{{order_id}}/confirm",
              "host": ["{{base_url}}"],
              "path": ["api", "vendas", "orders", "{{order_id}}", "confirm"]
            }
          }
        },
        {
          "name": "Cancelar Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vendas/orders/{{order_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "vendas", "orders", "{{order_id}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Health Checks",
      "item": [
        {
          "name": "Health Check - API Gateway",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Health Check - Vendas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{vendas_url}}/health",
              "host": ["{{vendas_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Health Check - Estoque",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{estoque_url}}/health",
              "host": ["{{estoque_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    }
  ]
}