{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "ecommerce-super-secret-key-that-should-be-changed-in-production",
    "Issuer": "EcommerceApiGateway",
    "Audience": "EcommerceClients",
    "ExpireHours": 24
  },
  "ReverseProxy": {
    "Routes": {
      "vendas-route": {
        "ClusterId": "vendas-cluster",
        "Match": {
          "Path": "/api/vendas/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          },
          {
            "RequestHeader": "X-Gateway-Source",
            "Set": "ApiGateway"
          }
        ],
        "AuthorizationPolicy": "JwtPolicy"
      },
      "estoque-route": {
        "ClusterId": "estoque-cluster",
        "Match": {
          "Path": "/api/inventario/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          },
          {
            "RequestHeader": "X-Gateway-Source",
            "Set": "ApiGateway"
          }
        ]
      }
    },
    "Clusters": {
      "vendas-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "estoque-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  },
  "ConnectionStrings": {
    "RabbitMQ": "amqp://localhost:5672"
  }
}
